# Bulut ortamı ayarları → "Environment variables" alanı için örnek.
# Biçim: .env, satır başına ANAHTAR=deger. Tırnaksız değerde # yorum başlatır.
#
# UYARI: Bu değerleri bu ortamı kullanan herkes okuyabilir ve VM'deki her komut görür.
# API anahtarı, token, şifre koyma. Bunun için "Network secrets" bölümünü kullan.

# Uzun derleme ve testler için komut zaman aşımları (milisaniye)
# Varsayılan: 2 dk bekler, en fazla 10 dk. 1800000'in üzeri arka plan sınırını da uzatır.
BASH_DEFAULT_TIMEOUT_MS=600000
BASH_MAX_TIMEOUT_MS=1800000

# templates/scripts/cloud-session-start.sh ayarları
SESSION_START_SERVICES="postgresql redis-server"
# SESSION_START_SKIP="ruby go"

# Uygulama ayarları (gizli olmayanlar)
NODE_ENV=development
LOG_LEVEL=debug

# .NET kullanıyorsan
# DOTNET_CLI_TELEMETRY_OPTOUT=1
# DOTNET_NOLOGO=1

# Deneysel: ajan takımları (varsayılan kapalı)
# CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS=1
